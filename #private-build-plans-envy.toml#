# Envy
[buildPlans.IosevkaEnvy]
family = "Iosevka Envy"
spacing = "fontconfig-mono"
serifs = "sans"
noCvSs = true
exportGlyphNames = false
buildTextureFeature = true

[buildPlans.IosevkaEnvy.metricOverride]
leading = 1450

[buildPlans.IosevkaEnvy.variants]
inherits = "ss10"

[buildPlans.IosevkaEnvy.variants.design]
zero = "slashed" 
asterisk = "penta-low"
underscore = "high"
tilde = "low"
# capital-w = "straight-serifless"
# capital-w = "rounded-vertical-sides-serifless"
lig-neq = "more-slanted-dotted"
lig-equal-chain = "without-notch"
lig-double-arrow-bar = "without-notch"
lig-hyphen-chain = "without-notch"
lig-plus-chain = "without-notch"
dollar = "through"

[buildPlans.IosevkaEnvy.weights.Light]
shape = 300
menu = 300
css = 300

[buildPlans.IosevkaEnvy.weights.Regular]
shape = 400
menu = 400
css = 400

[buildPlans.IosevkaEnvy.weights.Medium]
shape = 500
menu = 500
css = 500

[buildPlans.IosevkaEnvy.weights.SemiBold]
shape = 600
menu = 600
css = 600

[buildPlans.IosevkaEnvy.ligations]
inherits = "javascript"
disables = [
  "brace-bar",
  "brack-bar",
  "llgg",
  "llggeq",
  "logic",
  "lteq",
  "slash-asterisk"
]
enables = [
  "arrow-l",
  "arrow-lr",
  "arrow-r",
  "brst",
  "center-ops",
  "center-op-trigger-plus-minus-l",
  "center-op-trigger-plus-minus-r",
  "center-op-trigger-equal-l",
  "center-op-trigger-equal-r",
  "center-op-influence-colon",
  "center-op-influence-dot",
  "center-op-trigger-angle-inside",
  "center-op-trigger-angle-outside",
  "center-op-trigger-bar-l",
  "center-op-trigger-bar-r",
  "center-op-trigger-equal-l",
  "center-op-trigger-equal-r",
  "counter-arrow-l",
  "counter-arrow-r",
  "eqeqeq",
  "eqlt",
  "eqeq",
  "exeq",
  "exeqeq",
  "gteq",
  "hash-hash",
  "html-comment",
  "kern-bars",
  "kern-dotty",
  "lteq",
  "ltgt-diamond-tag",
  "ltgt-slash-tag",
  "minus-minus-minus",
  "plus-plus-plus",
  "underscore-underscore-underscore" ]

