  css = 700

[buildPlans.IosevkaMenloTall.widths.Normal]
  shape = 500
  menu = 5
  css = "normal"
  
  [buildPlans.IosevkaMenloTall.variants]
  inherits = "ss04"
  
    [buildPlans.IosevkaMenloTall.variants.design]
    one = "no-base"
    brace = "curly-flat-boundary"
    dollar = "open"
