# Iosevka Menlo

[buildPlans.IosevkaMenlo]
family = "Iosevka Menlo"
spacing = "normal"
serifs = "sans"
noCvSs = true
exportGlyphNames = false

  [buildPlans.IosevkaMenlo.weights.Light]
  shape = 300
  menu = 300
  css = 300
  
  [buildPlans.IosevkaMenlo.weights.Regular]
  shape = 400
  menu = 400
  css = 400
  
  [buildPlans.IosevkaMenlo.weights.Medium]
  shape = 500
  menu = 500
  css = 500
  
  [buildPlans.IosevkaMenlo.weights.SemiBold]
  shape = 600
  menu = 600
  css = 600
  
  [buildPlans.IosevkaMenlo.weights.Bold]
  shape = 700
  menu = 700
  css = 700

[buildPlans.IosevkaMenlo.widths.Normal]
  shape = 500
  menu = 5
  css = "normal"
  
  [buildPlans.IosevkaMenlo.variants]
  inherits = "ss04"
  
    [buildPlans.IosevkaMenlo.variants.design]
    one = "no-base"
    brace = "curly-flat-boundary"
    dollar = "open"
    five = "upright-flat-serifless"
    lower-lambda = "tailed-turn"
    zero = "dotted"
    lig-neq = "slightly-slanted-dotted"
    lig-equal-chain = 'without-notch'

  [buildPlans.IosevkaMenlo.ligations]
  inherits = "dlig"
  enables = ["eqeqeq", "exeqeq"]
  disables = ["slash-asterisk"]

# Iosevka Menlo Tall

