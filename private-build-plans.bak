# Iosevka JB 

[buildPlans.IosevkaJB]
family = "Iosevka JB"
spacing = "normal"
serifs = "sans"
noCvSs = true
exportGlyphNames = false

  [buildPlans.IosevkaJB.weights.Light]
  shape = 300
  menu = 300
  css = 300
  
  [buildPlans.IosevkaJB.weights.Regular]
  shape = 400
  menu = 400
  css = 400
  
  [buildPlans.IosevkaJB.weights.Medium]
  shape = 500
  menu = 500
  css = 500
  
  [buildPlans.IosevkaJB.weights.SemiBold]
  shape = 600
  menu = 600
  css = 600
  
  [buildPlans.IosevkaJB.weights.Bold]
  shape = 700
  menu = 700
  css = 700

[buildPlans.IosevkaJB.widths.Normal]
  shape = 500
  menu = 5
  css = "normal"
  
  [buildPlans.IosevkaJB.variants]
  inherits = "ss14"
  
    [buildPlans.IosevkaJB.variants.design]
    lower-lambda = "tailed-turn"
    zero = "dotted"
    lig-equal-chain = 'without-notch'
    lig-neq = "slightly-slanted-dotted"
    paren = "normal"
    lig-ltgteq = "flat"

    [buildPlans.IosevkaJB.variants.italic]
    # f = "serifless"
    f = "flat-hook-serifless"

  [buildPlans.IosevkaJB.ligations]
  inherits = "dlig"
  enables = ["eqeqeq", "exeqeq"]
  disables = ["slash-asterisk"]

